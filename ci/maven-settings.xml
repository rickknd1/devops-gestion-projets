<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings Maven utilisés par le stage « Deploy to Nexus ».
     Aucun secret ici : les identifiants viennent du credential Jenkins « nexus-credentials »,
     injectés en variables d'environnement par withCredentials. -->
<settings>
  <servers>
    <server>
      <id>nexus</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>
